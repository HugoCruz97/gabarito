<%# Uma linha do gabarito. `fields` = [campo da alternativa, campo da anulação] da versão
    e língua em edição (ver ExamQuestion::KEY_FIELDS). Em língua estrangeira a mesma
    questão aparece duas vezes (Inglês e Espanhol), com gabarito e anulação independentes. %>
<% option_field, annul_field = fields %>
<% base = "questions[#{question.id}]" %>
<% annulled = question[annul_field] %>
<%= tag.div data: { answer_key_target: "question", action: "click->answer-key#focusQuestion" },
      class: "group flex items-center gap-3 rounded-xl px-3 py-2 ring-1 ring-transparent transition
              data-[current]:bg-caramel-50 data-[current]:ring-caramel-300 data-[annulled]:opacity-60" do %>
  <span class="w-7 text-right font-mono text-sm font-bold text-stone-400 group-data-[current]:text-caramel-700"><%= question.number %></span>
  <div class="flex gap-1.5">
    <% @exam.options.each do |option| %>
      <label class="cursor-pointer has-[:disabled]:cursor-not-allowed">
        <%= radio_button_tag "#{base}[#{option_field}]", option, question[option_field] == option,
              id: "q#{question.id}_#{option_field}_#{option}", class: "peer sr-only", disabled: annulled,
              data: { action: "change->answer-key#answered" } %>
        <span class="bubble"><%= option %></span>
      </label>
    <% end %>
  </div>
  <label class="ml-auto cursor-pointer" title="Anular questão (todos ganham o ponto)">
    <%= hidden_field_tag "#{base}[#{annul_field}]", "0", id: nil %>
    <%= check_box_tag "#{base}[#{annul_field}]", "1", annulled, id: "q#{question.id}_#{annul_field}", class: "peer sr-only",
          data: { answer_key_target: "annul", action: "change->answer-key#refresh" } %>
    <span class="flex size-8 items-center justify-center rounded-lg text-stone-300 transition hover:bg-stone-100 hover:text-stone-500 peer-checked:bg-sand-100 peer-checked:text-sand-700">
      <%= icon :ban, class: "size-4" %>
    </span>
  </label>
<% end %>
