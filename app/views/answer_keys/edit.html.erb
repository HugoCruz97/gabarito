<% content_for :title, "Gabarito · #{@exam.title}" %>
<%= render layout: "shared/page_header", locals: { title: "Gabarito", subtitle: @exam.title } do %>
  <%= link_to "Voltar ao simulado", @exam, class: ApplicationHelper::SECONDARY_BUTTON_CLASS %>
<% end %>

<%= form_with url: exam_answer_key_path(@exam), method: :patch, class: "space-y-6" do %>
  <% @questions_by_subject.each do |exam_subject, questions| %>
    <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="mb-4 text-lg font-semibold">
        <%= exam_subject.subject.name %>
        <span class="text-sm font-normal text-gray-500">· <%= points(exam_subject.points_per_question) %> ponto(s) cada</span>
      </h2>
      <div class="grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
        <% questions.each do |question| %>
          <div class="flex items-center gap-3">
            <span class="w-8 text-right font-mono font-semibold"><%= question.number %></span>
            <div class="flex gap-1">
              <% @exam.options.each do |option| %>
                <label class="cursor-pointer">
                  <%= radio_button_tag "questions[#{question.id}][correct_option]", option, question.correct_option == option, class: "peer sr-only" %>
                  <span class="flex h-8 w-8 items-center justify-center rounded-full border border-gray-300 text-sm peer-checked:border-indigo-600 peer-checked:bg-indigo-600 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-400"><%= option %></span>
                </label>
              <% end %>
            </div>
            <label class="ml-2 flex items-center gap-1 text-xs text-gray-500">
              <%= hidden_field_tag "questions[#{question.id}][annulled]", "0", id: nil %>
              <%= check_box_tag "questions[#{question.id}][annulled]", "1", question.annulled?, class: "rounded border-gray-300" %>
              Anulada
            </label>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= submit_tag "Salvar gabarito", class: ApplicationHelper::BUTTON_CLASS %>
<% end %>
