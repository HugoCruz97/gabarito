<% content_for :title, "Gabarito · #{@exam.title}" %>

<%= link_to exam_path(@exam), class: "mb-4 inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-navy-800" do %>
  <%= icon :arrow_left, class: "size-4" %> <%= @exam.title %>
<% end %>

<%= form_with url: exam_answer_key_path(@exam), method: :patch,
      data: { controller: "answer-key", answer_key_options_value: @exam.options.join,
              action: "keydown@window->answer-key#keydown" } do %>

  <%= page_header "Gabarito", eyebrow: "Simulado" do %>
    <%= button_tag type: "submit", class: "btn btn-primary" do %><%= icon :check %> Salvar gabarito<% end %>
  <% end %>

  <%# ---------- Barra de progresso fixa ---------- %>
  <div class="sticky top-16 z-10 -mx-4 mb-6 border-b border-slate-200/70 bg-slate-50/80 px-4 py-3 backdrop-blur-xl sm:-mx-8 sm:px-8">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <div class="flex min-w-48 flex-1 items-center gap-3">
        <div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-200">
          <div data-answer-key-target="progressBar" class="h-full rounded-full bg-gradient-to-r from-green-400 to-green-600 transition-all duration-300" style="width: 0%"></div>
        </div>
        <span class="text-sm font-bold text-navy-900 tabular-nums"><span data-answer-key-target="progressCount">0</span>/<span data-answer-key-target="progressTotal">0</span></span>
      </div>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
        <span class="flex items-center gap-1"><%= icon :keyboard, class: "size-4" %> Digite</span>
        <span class="flex items-center gap-1"><% @exam.options.each do |o| %><kbd class="kbd"><%= o %></kbd><% end %> marca e avança</span>
        <span class="flex items-center gap-1"><kbd class="kbd">←</kbd><kbd class="kbd">→</kbd> navega</span>
        <span class="flex items-center gap-1"><kbd class="kbd">⌫</kbd> limpa</span>
        <span class="flex items-center gap-1"><kbd class="kbd">X</kbd> anula</span>
        <span class="flex items-center gap-1"><kbd class="kbd">Ctrl</kbd><kbd class="kbd">S</kbd> salva</span>
      </p>
    </div>
  </div>

  <div class="space-y-6">
    <% @questions_by_subject.each do |exam_subject, questions| %>
      <section class="card p-5 sm:p-6">
        <div class="mb-4 flex flex-wrap items-center gap-3">
          <span class="size-3 rounded-full" style="background: <%= subject_color(exam_subject.subject) %>"></span>
          <h2 class="text-lg font-bold text-navy-900"><%= exam_subject.subject.name %></h2>
          <span class="badge badge-slate">Questões <%= questions.first.number %>–<%= questions.last.number %></span>
          <span class="badge badge-navy"><%= points(exam_subject.points_per_question) %> pt cada</span>
          <% if exam_subject.foreign_language? %><span class="badge badge-green">Inglês e Espanhol</span><% end %>
        </div>

        <% if exam_subject.foreign_language? %>
          <div class="grid gap-6 lg:grid-cols-2">
            <% { correct_option: "Inglês", correct_option_es: "Espanhol" }.each do |field, label| %>
              <div class="rounded-2xl bg-slate-50/70 p-3 ring-1 ring-slate-100">
                <p class="mb-2 px-3 text-sm font-bold text-navy-900"><%= label %></p>
                <div class="grid gap-1">
                  <% questions.each do |question| %>
                    <%= render "question", question: question, field: field %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="grid gap-2 sm:grid-cols-2 xl:grid-cols-3">
            <% questions.each do |question| %>
              <%= render "question", question: question, field: :correct_option %>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>

  <div class="mt-8 flex justify-end">
    <%= button_tag type: "submit", class: "btn btn-primary px-6 py-3" do %><%= icon :check %> Salvar gabarito<% end %>
  </div>
<% end %>
