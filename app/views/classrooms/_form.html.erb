<%= form_with model: classroom, class: "max-w-lg space-y-5 rounded-lg border border-gray-200 bg-white p-6 shadow-sm" do |f| %>
  <%= render "shared/errors", record: classroom %>
  <div>
    <%= f.label :name, class: ApplicationHelper::LABEL_CLASS %>
    <%= f.text_field :name, placeholder: "Ex.: 9º ano A", autofocus: true, class: ApplicationHelper::INPUT_CLASS %>
  </div>
  <div>
    <%= f.label :school_year, class: ApplicationHelper::LABEL_CLASS %>
    <%= f.number_field :school_year, class: ApplicationHelper::INPUT_CLASS %>
  </div>
  <div class="flex gap-2">
    <%= f.submit "Salvar", class: ApplicationHelper::BUTTON_CLASS %>
    <%= link_to "Cancelar", classroom.persisted? ? classroom : classrooms_path, class: ApplicationHelper::SECONDARY_BUTTON_CLASS %>
  </div>
<% end %>
