<%= form_with model: classroom, class: "card max-w-xl space-y-5 p-6 sm:p-8" do |f| %>
  <%= render "shared/errors", record: classroom %>
  <div>
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, placeholder: "Ex.: 9º ano A", autofocus: true, class: "input" %>
  </div>
  <div>
    <%= f.label :school_year, class: "label" %>
    <%= f.number_field :school_year, class: "input max-w-40" %>
  </div>
  <div class="flex gap-2 pt-2">
    <%= f.button type: "submit", class: "btn btn-primary" do %><%= icon :check %> Salvar<% end %>
    <%= link_to "Cancelar", classroom.persisted? ? classroom : classrooms_path, class: "btn btn-ghost" %>
  </div>
<% end %>
