<% content_for :title, "Turmas" %>
<%= page_header "Turmas", eyebrow: "Escola", subtitle: "#{pluralize(@classrooms.size, 'turma')} · #{pluralize(@classrooms.sum { |c| c.students.size }, 'aluno')}" do %>
  <%= link_to new_classroom_path, class: "btn btn-primary" do %><%= icon :plus %> Nova turma<% end %>
<% end %>

<% if @classrooms.any? %>
  <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
    <% @classrooms.each_with_index do |classroom, i| %>
      <%= link_to classroom, class: "card card-hover group relative overflow-hidden p-6 animate-slide-up", style: "animation-delay: #{[ i, 8 ].min * 50}ms" do %>
        <div class="pointer-events-none absolute -top-12 -right-12 size-32 rounded-full bg-green-400/10 blur-2xl transition group-hover:bg-green-400/20"></div>
        <div class="relative flex items-start justify-between">
          <span class="flex size-12 items-center justify-center rounded-2xl gradient-brand text-white shadow-lg shadow-green-700/20"><%= icon :classrooms %></span>
          <% if classroom.school_year %><span class="badge badge-navy"><%= classroom.school_year %></span><% end %>
        </div>
        <p class="relative mt-5 text-xl font-extrabold tracking-tight text-navy-900 dark:text-white"><%= classroom.name %></p>
        <div class="relative mt-4 flex items-center justify-between">
          <div class="flex -space-x-2">
            <% classroom.students.first(5).each do |student| %>
              <span class="rounded-full ring-2 ring-white dark:ring-navy-900"><%= avatar(student.name, size: "size-8 text-[10px]") %></span>
            <% end %>
            <% if classroom.students.size > 5 %>
              <span class="flex size-8 items-center justify-center rounded-full bg-slate-100 text-[10px] font-bold text-slate-500 ring-2 ring-white dark:bg-white/10 dark:ring-navy-900">+<%= classroom.students.size - 5 %></span>
            <% end %>
          </div>
          <span class="text-sm font-medium text-slate-500"><%= pluralize(classroom.students.size, "aluno") %></span>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= empty_state :classrooms, "Nenhuma turma cadastrada", "Crie as turmas para depois cadastrar os alunos e aplicar os simulados." do %>
    <%= link_to new_classroom_path, class: "btn btn-primary" do %><%= icon :plus %> Criar turma<% end %>
  <% end %>
<% end %>
