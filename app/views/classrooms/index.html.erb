<% content_for :title, "Turmas" %>
<%= render layout: "shared/page_header", locals: { title: "Turmas" } do %>
  <%= link_to "Nova turma", new_classroom_path, class: ApplicationHelper::BUTTON_CLASS %>
<% end %>

<% if @classrooms.any? %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @classrooms.each do |classroom| %>
      <%= link_to classroom, class: "block rounded-lg border border-gray-200 bg-white p-5 shadow-sm hover:border-indigo-300" do %>
        <p class="text-lg font-semibold"><%= classroom.name %></p>
        <p class="text-sm text-gray-500"><%= classroom.school_year %> · <%= pluralize(classroom.students.size, "aluno") %></p>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-500">Nenhuma turma cadastrada ainda.</p>
<% end %>
