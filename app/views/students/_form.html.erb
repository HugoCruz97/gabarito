<%= form_with model: student, class: "max-w-lg space-y-5 rounded-lg border border-gray-200 bg-white p-6 shadow-sm" do |f| %>
  <%= render "shared/errors", record: student %>
  <div>
    <%= f.label :name, class: ApplicationHelper::LABEL_CLASS %>
    <%= f.text_field :name, autofocus: true, class: ApplicationHelper::INPUT_CLASS %>
  </div>
  <div>
    <%= f.label :registration_number, class: ApplicationHelper::LABEL_CLASS %>
    <%= f.text_field :registration_number, class: ApplicationHelper::INPUT_CLASS %>
    <p class="mt-1 text-xs text-gray-500">Opcional. Use o mesmo número do cartão-resposta, se houver.</p>
  </div>
  <div>
    <%= f.label :classroom_id, class: ApplicationHelper::LABEL_CLASS %>
    <%= f.collection_select :classroom_id, Classroom.order(:name), :id, :display_name,
          { include_blank: "Selecione…" }, class: ApplicationHelper::INPUT_CLASS %>
  </div>
  <div class="flex gap-2">
    <%= f.submit "Salvar", class: ApplicationHelper::BUTTON_CLASS %>
    <% if student.new_record? %>
      <%= f.submit "Salvar e cadastrar outro", name: "add_another", class: ApplicationHelper::SECONDARY_BUTTON_CLASS %>
    <% end %>
  </div>
<% end %>
