<% if students.any? %>
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Aluno</th>
            <th>Matrícula</th>
            <% if show_classroom %><th>Turma</th><% end %>
            <th class="w-10"></th>
          </tr>
        </thead>
        <tbody>
          <% students.each do |student| %>
            <tr class="group">
              <td>
                <%= link_to student, class: "flex items-center gap-3 font-semibold text-navy-900 hover:text-green-700", data: { turbo_frame: "_top" } do %>
                  <%= avatar(student.name) %> <%= student.name %>
                <% end %>
              </td>
              <td class="font-mono text-xs text-slate-500"><%= student.registration_number || "—" %></td>
              <% if show_classroom %>
                <td><span class="badge badge-navy"><%= student.classroom.name %></span></td>
              <% end %>
              <td class="text-right">
                <%= link_to edit_student_path(student), class: "btn btn-ghost btn-icon btn-sm opacity-0 transition group-hover:opacity-100 focus:opacity-100", title: "Editar", data: { turbo_frame: "_top" } do %>
                  <%= icon :pencil, class: "size-4" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card px-6 py-12 text-center text-sm text-slate-500">Nenhum aluno encontrado.</div>
<% end %>
