<% if students.any? %>
  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-left text-gray-600">
        <tr>
          <th class="px-4 py-3 font-medium">Nome</th>
          <th class="px-4 py-3 font-medium">Matrícula</th>
          <% if show_classroom %><th class="px-4 py-3 font-medium">Turma</th><% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% students.each do |student| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3"><%= link_to student.name, student, class: "font-medium text-indigo-700 hover:underline" %></td>
            <td class="px-4 py-3 text-gray-600"><%= student.registration_number || "—" %></td>
            <% if show_classroom %><td class="px-4 py-3 text-gray-600"><%= student.classroom.name %></td><% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-gray-500">Nenhum aluno encontrado.</p>
<% end %>
