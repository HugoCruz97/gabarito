<% content_for :title, "Nova matéria" %>
<h1 class="mb-6 text-2xl font-bold">Nova matéria</h1>
<%= form_with model: @subject, class: "flex max-w-lg gap-2" do |f| %>
  <%= f.text_field :name, autofocus: true, class: ApplicationHelper::INPUT_CLASS %>
  <%= f.submit "Salvar", class: ApplicationHelper::BUTTON_CLASS %>
<% end %>
