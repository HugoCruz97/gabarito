<% content_for :title, "Nova matéria" %>
<%= page_header "Nova matéria", eyebrow: "Matérias" %>
<%= form_with model: @subject, class: "card flex max-w-xl gap-2 p-2" do |f| %>
  <%= f.text_field :name, autofocus: true, placeholder: "Nome da matéria", class: "input flex-1 !shadow-none !ring-0" %>
  <%= f.button type: "submit", class: "btn btn-primary" do %><%= icon :check %> Salvar<% end %>
<% end %>
