<%= turbo_frame_tag @subject do %>
  <%= form_with model: @subject, class: "flex items-center gap-2 bg-green-50/50 px-4 py-2.5", data: { turbo_frame: "_top" } do |f| %>
    <%= f.text_field :name, autofocus: true, class: "input flex-1" %>
    <%= f.button type: "submit", class: "btn btn-primary btn-sm" do %><%= icon :check, class: "size-4" %> Salvar<% end %>
    <%= link_to "Cancelar", subjects_path, class: "btn btn-ghost btn-sm" %>
  <% end %>
  <% if @subject.errors.any? %>
    <p class="px-4 pb-2 text-sm text-red-600"><%= @subject.errors.full_messages.to_sentence %></p>
  <% end %>
<% end %>
