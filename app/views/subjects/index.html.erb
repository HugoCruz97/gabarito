<% content_for :title, "Matérias" %>
<%= render layout: "shared/page_header", locals: { title: "Matérias", subtitle: "Cadastre uma vez e reutilize em todos os simulados." } do %><% end %>

<%= form_with model: @subject, class: "mb-6 flex max-w-lg gap-2" do |f| %>
  <%= f.text_field :name, placeholder: "Nova matéria (ex.: Matemática)", class: ApplicationHelper::INPUT_CLASS %>
  <%= f.submit "Adicionar", class: ApplicationHelper::BUTTON_CLASS %>
<% end %>
<% if @subject.errors.any? %>
  <p class="-mt-4 mb-6 text-sm text-red-600"><%= @subject.errors.full_messages.to_sentence %></p>
<% end %>

<% if @subjects.any? %>
  <ul class="max-w-lg divide-y divide-gray-100 rounded-lg border border-gray-200 bg-white shadow-sm">
    <% @subjects.each do |subject| %>
      <li><%= render subject %></li>
    <% end %>
  </ul>
<% else %>
  <p class="text-gray-500">Nenhuma matéria cadastrada ainda.</p>
<% end %>
