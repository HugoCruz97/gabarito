<% content_for :title, "Matérias" %>
<%= page_header "Matérias", eyebrow: "Catálogo", subtitle: "Cadastre uma vez e reutilize em todos os simulados." %>

<div class="max-w-2xl">
  <%= form_with model: @subject, class: "card mb-6 flex gap-2 p-2" do |f| %>
    <%= f.text_field :name, placeholder: "Nova matéria (ex.: Matemática)", class: "input flex-1 !shadow-none !ring-0" %>
    <%= f.button type: "submit", class: "btn btn-primary" do %><%= icon :plus %> Adicionar<% end %>
  <% end %>
  <% if @subject.errors.any? %>
    <p class="-mt-4 mb-6 px-2 text-sm text-red-600"><%= @subject.errors.full_messages.to_sentence %></p>
  <% end %>

  <% if @subjects.any? %>
    <ul class="card divide-y divide-stone-100 overflow-hidden">
      <% @subjects.each do |subject| %>
        <li><%= render subject %></li>
      <% end %>
    </ul>
  <% else %>
    <%= empty_state :subjects, "Nenhuma matéria ainda", "Adicione as matérias que aparecem nos simulados: Português, Matemática, Ciências…" %>
  <% end %>
</div>
