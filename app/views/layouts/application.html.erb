<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Metaverso Simulados" : "Metaverso Simulados" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Metaverso Simulados">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-900">
    <nav class="bg-indigo-600">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-2 px-4 py-3">
        <%= link_to "Metaverso Simulados", root_path, class: "mr-4 text-lg font-semibold text-white" %>
        <%= nav_link "Simulados", exams_path %>
        <%= nav_link "Turmas", classrooms_path %>
        <%= nav_link "Alunos", students_path %>
        <%= nav_link "Matérias", subjects_path %>
      </div>
    </nav>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <% if notice %>
        <p class="mb-6 rounded-md bg-green-50 px-4 py-3 text-green-800"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="mb-6 rounded-md bg-red-50 px-4 py-3 text-red-800"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
