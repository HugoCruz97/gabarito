<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Simulados" : "Simulados" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Simulados">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#2f241e">
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh" data-controller="command-palette sidebar" data-action="keydown.ctrl+k@window->command-palette#open:prevent keydown.meta+k@window->command-palette#open:prevent">
    <%# ---------- Menu lateral ---------- %>
    <div data-sidebar-target="backdrop" data-action="click->sidebar#close" class="fixed inset-0 z-30 hidden bg-cocoa-950/60 backdrop-blur-sm lg:hidden"></div>

    <aside data-sidebar-target="panel"
           class="fixed inset-y-0 left-0 z-40 flex w-72 -translate-x-full flex-col overflow-hidden bg-cocoa-900 text-white transition-transform duration-300 lg:translate-x-0 print:hidden">
      <%# brilhos de fundo em tons de caramelo e areia %>
      <div class="pointer-events-none absolute -top-24 -left-20 size-72 rounded-full bg-caramel-500/25 blur-3xl"></div>
      <div class="pointer-events-none absolute -right-24 bottom-10 size-72 rounded-full bg-cocoa-400/25 blur-3xl"></div>

      <div class="relative flex items-center gap-3 px-6 pt-7 pb-8">
        <span class="flex size-11 items-center justify-center rounded-2xl bg-white/10 ring-1 ring-white/15 backdrop-blur">
          <%= brand_mark(class: "size-8") %>
        </span>
        <div class="leading-tight">
          <p class="text-[11px] font-semibold tracking-[0.2em] text-caramel-300 uppercase">Correção inteligente</p>
          <p class="text-xl font-extrabold tracking-tight">Simulados</p>
        </div>
      </div>

      <nav class="relative flex-1 space-y-1 px-4">
        <%= nav_link "Início", root_path, :dashboard %>
        <%= nav_link "Simulados", exams_path, :exams %>
        <%= nav_link "Turmas", classrooms_path, :classrooms %>
        <%= nav_link "Alunos", students_path, :students %>
        <%= nav_link "Matérias", subjects_path, :subjects %>
      </nav>
    </aside>

    <%# ---------- Conteúdo ---------- %>
    <div class="lg:pl-72 print:pl-0">
      <header class="sticky top-0 z-20 border-b border-stone-200/70 bg-sand-50/80 backdrop-blur-xl print:hidden">
        <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-8">
          <button type="button" data-action="sidebar#open" class="btn btn-ghost btn-icon lg:hidden" aria-label="Abrir menu">
            <%= icon :menu %>
          </button>
          <span class="flex items-center gap-2 font-bold lg:hidden"><%= brand_mark(class: "size-7") %> Simulados</span>

          <button type="button" data-action="command-palette#open"
                  class="ml-auto flex w-full max-w-sm cursor-pointer items-center gap-3 rounded-xl bg-white px-3.5 py-2 text-sm text-stone-400 ring-1 ring-stone-200 transition hover:ring-stone-300 max-sm:w-auto max-sm:ring-0 max-sm:bg-transparent">
            <%= icon :search, class: "size-4" %>
            <span class="max-sm:hidden">Buscar alunos, turmas, simulados…</span>
            <span class="ml-auto flex gap-1 max-sm:hidden"><kbd class="kbd">Ctrl</kbd><kbd class="kbd">K</kbd></span>
          </button>
        </div>
      </header>

      <main class="mx-auto max-w-7xl px-4 py-8 sm:px-8 sm:py-10 print:max-w-none print:p-0">
        <%= yield %>
      </main>
    </div>

    <%# ---------- Notificações (toasts) ---------- %>
    <div id="toasts" class="pointer-events-none fixed right-4 bottom-4 z-50 flex w-full max-w-sm flex-col gap-3 print:hidden">
      <% { notice: :check_circle, alert: :alert }.each do |type, icon_name| %>
        <% if (message = flash[type]) %>
          <div data-controller="toast" class="pointer-events-auto relative flex animate-toast-in overflow-hidden items-start gap-3 rounded-2xl bg-white p-4 shadow-2xl shadow-cocoa-900/15 ring-1 ring-stone-200">
            <span class="<%= type == :notice ? 'text-caramel-500' : 'text-red-500' %>"><%= icon icon_name %></span>
            <p class="flex-1 text-sm font-medium"><%= message %></p>
            <button type="button" data-action="toast#dismiss" class="text-stone-400 hover:text-stone-600" aria-label="Fechar"><%= icon :x, class: "size-4" %></button>
            <span data-toast-target="bar" class="absolute inset-x-4 bottom-0 h-0.5 origin-left rounded-full <%= type == :notice ? 'bg-caramel-500' : 'bg-red-500' %>"></span>
          </div>
        <% end %>
      <% end %>
    </div>

    <%= render "shared/command_palette" %>
    <%= render "shared/confirm_dialog" %>
  </body>
</html>
