<% content_for :title, "Simulados" %>
<%= page_header "Simulados", eyebrow: "Avaliações", subtitle: "#{pluralize(@exams.size, 'simulado', plural: 'simulados')} criados" do %>
  <%= link_to new_exam_path, class: "btn btn-primary" do %><%= icon :plus %> Novo simulado<% end %>
<% end %>

<% if @exams.any? %>
  <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    <% @exams.each_with_index do |exam, i| %>
      <div class="animate-slide-up" style="animation-delay: <%= [ i, 8 ].min * 50 %>ms">
        <%= render "exam_card", exam: exam %>
      </div>
    <% end %>
  </div>
<% else %>
  <%= empty_state :exams, "Nenhum simulado ainda",
        "Defina as matérias, quantas questões cada uma tem e quanto vale cada questão. O gabarito é montado automaticamente." do %>
    <%= link_to new_exam_path, class: "btn btn-primary" do %><%= icon :plus %> Criar primeiro simulado<% end %>
  <% end %>
<% end %>
