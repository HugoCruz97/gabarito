<% content_for :title, "Simulados" %>
<%= render layout: "shared/page_header", locals: { title: "Simulados" } do %>
  <%= link_to "Novo simulado", new_exam_path, class: ApplicationHelper::BUTTON_CLASS %>
<% end %>

<% if @exams.any? %>
  <div class="grid gap-4 md:grid-cols-2">
    <% @exams.each do |exam| %>
      <%= link_to exam, class: "block rounded-lg border border-gray-200 bg-white p-5 shadow-sm hover:border-indigo-300" do %>
        <div class="flex items-start justify-between gap-2">
          <p class="text-lg font-semibold"><%= exam.title %></p>
          <span class="whitespace-nowrap text-sm text-gray-500"><%= l(exam.applied_on) if exam.applied_on %></span>
        </div>
        <p class="mt-1 text-sm text-gray-500">
          <%= exam.classrooms.map(&:name).to_sentence.presence || "Sem turma" %> ·
          <%= exam.total_questions %> questões · <%= points(exam.total_points) %> pontos
        </p>
        <p class="mt-2 text-sm text-gray-700"><%= exam.exam_subjects.map { |s| s.subject.name }.join(", ") %></p>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="rounded-lg border border-dashed border-gray-300 p-10 text-center">
    <p class="text-gray-500">Nenhum simulado criado ainda.</p>
    <% if Subject.none? || Classroom.none? %>
      <p class="mt-2 text-sm text-gray-500">
        Comece cadastrando as <%= link_to "matérias", subjects_path, class: "text-indigo-700 underline" %>
        e as <%= link_to "turmas", classrooms_path, class: "text-indigo-700 underline" %>.
      </p>
    <% end %>
  </div>
<% end %>
