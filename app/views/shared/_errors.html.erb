<% if record.errors.any? %>
  <div class="mb-6 rounded-md bg-red-50 px-4 py-3 text-red-800">
    <p class="font-medium">Corrija os itens abaixo:</p>
    <ul class="mt-1 list-disc pl-5 text-sm">
      <% record.errors.full_messages.uniq.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
