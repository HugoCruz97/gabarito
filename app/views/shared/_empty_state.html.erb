<div class="card relative overflow-hidden px-6 py-16 text-center animate-fade-in">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(49,185,120,0.10),transparent_60%)]"></div>
  <div class="relative mx-auto mb-5 flex size-16 items-center justify-center rounded-2xl gradient-brand text-white shadow-xl shadow-green-700/20">
    <%= icon icon_name, class: "size-7" %>
  </div>
  <h3 class="relative text-lg font-bold text-navy-900"><%= title %></h3>
  <% if description %>
    <p class="relative mx-auto mt-2 max-w-md text-sm text-slate-500"><%= description %></p>
  <% end %>
  <div class="relative mt-6 flex justify-center gap-2"><%= yield %></div>
</div>
