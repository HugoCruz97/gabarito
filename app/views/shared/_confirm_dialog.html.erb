<%# Substitui o confirm() do navegador nos botões com data-turbo-confirm (ver confirm.js) %>
<dialog id="confirm-dialog"
        class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl bg-white p-6 shadow-2xl ring-1 ring-slate-200 dark:bg-navy-900 dark:text-slate-200 dark:ring-white/10">
  <form method="dialog">
    <div class="flex gap-4">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600 dark:bg-red-500/10 dark:text-red-400">
        <%= icon :alert %>
      </span>
      <div>
        <h3 class="text-lg font-bold text-navy-900 dark:text-white">Tem certeza?</h3>
        <p data-confirm-message class="mt-1 text-sm text-slate-500 dark:text-slate-400"></p>
      </div>
    </div>
    <div class="mt-6 flex justify-end gap-2">
      <button value="cancel" class="btn btn-secondary" autofocus>Cancelar</button>
      <button value="confirm" class="btn bg-red-600 text-white shadow-lg shadow-red-600/20 hover:bg-red-500">Sim, excluir</button>
    </div>
  </form>
</dialog>
