<% content_for :title, "Importar alunos" %>

<%= link_to students_path, class: "mb-4 inline-flex items-center gap-1 text-sm font-medium text-stone-500 hover:text-cocoa-800" do %>
  <%= icon :arrow_left, class: "size-4" %> Alunos
<% end %>

<%= page_header "Importar alunos", eyebrow: "Planilha do Excel",
      subtitle: "Cadastre a turma inteira de uma vez. Antes de gravar, você vê uma prévia do que vai acontecer." %>

<div class="grid gap-6 lg:grid-cols-3">
  <%= form_with url: student_import_path, multipart: true, class: "card space-y-5 p-6 lg:col-span-2" do |f| %>
    <label class="group flex cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-stone-300 bg-white px-6 py-10 text-center transition hover:border-caramel-400 hover:bg-caramel-50/40"
           data-controller="file-name">
      <span class="mb-3 flex size-12 items-center justify-center rounded-2xl gradient-brand text-white shadow-lg"><%= icon :students %></span>
      <span class="text-base font-bold text-cocoa-900" data-file-name-target="label">Escolha a planilha (.xlsx)</span>
      <span class="mt-1 text-sm text-stone-500">Colunas: Nome, Matrícula, Turma e Adaptada</span>
      <%= f.file_field :file, accept: ".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            class: "sr-only", required: true, data: { action: "change->file-name#update", file_name_target: "input" } %>
    </label>

    <div>
      <%= f.label :default_classroom_id, "Turma padrão (opcional)", class: "label" %>
      <%= f.select :default_classroom_id, options_from_collection_for_select(Classroom.order(:name), :id, :display_name),
            { include_blank: "Nenhuma — a planilha tem a coluna Turma" }, class: "input" %>
      <p class="hint">Usada para as linhas sem turma. Útil quando a planilha é de uma turma só e não tem essa coluna.</p>
    </div>

    <%= f.button type: "submit", class: "btn btn-primary", data: { turbo_submits_with: "Lendo planilha…" } do %>
      <%= icon :arrow_right %> Ver prévia
    <% end %>
  <% end %>

  <aside class="space-y-4">
    <div class="card p-6">
      <h2 class="font-bold text-cocoa-900">Como montar a planilha</h2>
      <ul class="mt-3 space-y-2 text-sm text-stone-600">
        <li class="flex gap-2"><%= icon :check, class: "mt-0.5 size-4 shrink-0 text-caramel-500" %> Primeira linha com os títulos: <strong>Nome</strong>, Matrícula, Turma, Adaptada.</li>
        <li class="flex gap-2"><%= icon :check, class: "mt-0.5 size-4 shrink-0 text-caramel-500" %> Só <strong>Nome</strong> é obrigatório. A ordem das colunas não importa.</li>
        <li class="flex gap-2"><%= icon :check, class: "mt-0.5 size-4 shrink-0 text-caramel-500" %> Turmas que não existem são criadas na hora.</li>
        <li class="flex gap-2"><%= icon :check, class: "mt-0.5 size-4 shrink-0 text-caramel-500" %> Adaptada: escreva <strong>Sim</strong> para quem faz prova adaptada.</li>
        <li class="flex gap-2"><%= icon :check, class: "mt-0.5 size-4 shrink-0 text-caramel-500" %> Pode importar de novo sem duplicar: alunos já cadastrados são reconhecidos pela matrícula (ou pelo nome na turma).</li>
      </ul>
      <%= link_to template_student_import_path, class: "btn btn-secondary mt-5 w-full", data: { turbo: false } do %>
        Baixar planilha modelo
      <% end %>
    </div>
  </aside>
</div>
